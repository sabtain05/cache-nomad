{
  "name": "cache-nomad",
  "version": "1.6.0",
  "description": "A dead-simple, local-first syncing library for offline state and background updates.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run --environment jsdom"
  },
  "keywords": [
    "cache",
    "offline",
    "sync",
    "local-first",
    "nomad"
  ],
  "author": "Sabtain Ali",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  }
}
